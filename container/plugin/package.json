{
  "name": "@dsh-container/adapt",
  "version": "0.1.0",
  "description": "Container adaptation plugin for the dsh-container image",
  "homepage": "https://github.com/NIyueeE/dsh-container",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
