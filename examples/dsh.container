# systemd Quadlet example for Podman >= 4.4.
# See docs/deployment.md for the full guide.
#
# Install:
#   sudo mkdir -p /etc/containers/systemd
#   sudo cp examples/dsh.container /etc/containers/systemd/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dsh.service
#
# Pulls the published GHCR image; no local build is required.
# Open http://127.0.0.1:3081 (PublishPort on the default bridge network).

[Unit]
Description=DeepSeek Harness (dsh) Web UI
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/niyueee/dsh-container:latest
ContainerName=dsh
# Host 3081 -> container 3081. Caddy listens on 0.0.0.0:3081 inside the
# container and rewrites Host/Origin to loopback before forwarding to dsh on
# 127.0.0.1:3080. For host-loopback-only access use:
# PublishPort=127.0.0.1:3081:3081
PublishPort=3081:3081
# Runtime configuration surface: auth pair + optional auto-update.
# Auto-update is off by default; set to 1 to follow npm latest on boot.
Environment=DSH_AUTO_UPDATE=0
# Set both auth variables or neither. Setting only one fails startup.
# Environment=DSH_PROXY_USER=admin
# Environment=DSH_PROXY_PASSWORD=replace-with-a-strong-password
# Optional: change dsh's internal port (the exposed port stays 3081).
# Exec=--port 8080
# Restart dsh web without restarting the container:
#   podman exec dsh dsh-restart
# Persist the whole user home. User state and user-installed tools survive
# image upgrades; the system layer is replaced. For host-visible storage use a
# bind mount owned by uid 1000 (keep :Z on SELinux):
# Volume=/home/you/dsh-home:/home/dsh:Z
Volume=dsh-home:/home/dsh
# Pull a newer image on restart and check the registry periodically:
Pull=newer
AutoUpdate=registry

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
