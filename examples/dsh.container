# systemd Quadlet 示例(Podman >= 4.4)。
# 完整部署说明见 docs/deployment.md。
#
# 部署步骤:
#   sudo mkdir -p /etc/containers/systemd
#   sudo cp examples/dsh.container /etc/containers/systemd/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dsh.service
#
# 镜像直接从 GitHub Container Registry 拉取, 不在本地构建。
# 镜像只在 v* tag 发布时推送; :latest 指向最近一次发布,
# 首次部署前请确认仓库至少发布过一个版本(或用具体版本替换 Image)。
# 访问 http://127.0.0.1:3080(PublishPort 映射, 默认桥接网络)。

[Unit]
Description=DeepSeek Harness (dsh) Web UI
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/niyueee/dsh-container:latest
ContainerName=dsh
# 端口映射: 宿主 3080 -> 容器 3080(容器内 socat 转发: 容器 IP:3080 ->
# dsh 的 127.0.0.1:3080, 见 DSH_WEB_HOST); 只在本机使用可改为
# PublishPort=127.0.0.1:3080:3080。
PublishPort=3080:3080
Environment=DSH_HOME=/dsh
# 容器启动时自动把 dsh 更新到 npm 最新版; 设为 0 可关闭。
Environment=DSH_AUTO_UPDATE=1
# dsh 对外暴露方式: 0.0.0.0 = 内置 socat 转发(配合上面的 PublishPort);
# 127.0.0.1 = 仅回环(端口映射无效, 需 host 网络或隧道)。
Environment=DSH_WEB_HOST=0.0.0.0
# dsh 数据目录(profiles / sessions / 插件)持久化。
Volume=dsh-home:/dsh
# 任务工作区: 路径按需修改, 属主需为 uid 1000; SELinux 主机保留 :Z。
Volume=/home/you/workspace:/workspace:Z
# 镜像更新: 重启时若远端有更新则拉取新镜像; AutoUpdate=registry 供
# podman-auto-update 服务定时检查(见 docs/deployment.md 自动更新一节)。
Pull=newer
AutoUpdate=registry

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
